<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: padlock with keyhole, matching assets/icon.svg.
  Drawn within the 108dp canvas; shapes kept inside the ~66dp safe zone.
  Background color comes from @color/ic_launcher_background (#1E1E2E).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shackle (arch + legs), stroked -->
    <path
        android:strokeColor="#89B4FA"
        android:strokeWidth="7.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M41,58 L41,47 A13,13 0 0 1 67,47 L67,58" />

    <!-- Lock body (rounded rectangle) -->
    <path
        android:fillColor="#89B4FA"
        android:pathData="M36,56 L72,56 A6,6 0 0 1 78,62 L78,82 A6,6 0 0 1 72,88 L36,88 A6,6 0 0 1 30,82 L30,62 A6,6 0 0 1 36,56 Z" />

    <!-- Keyhole: circle + stem -->
    <path
        android:fillColor="#1E1E2E"
        android:pathData="M54,64 m-5,0 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0" />
    <path
        android:fillColor="#1E1E2E"
        android:pathData="M51.6,68 L56.4,68 L56.4,79 A2.4,2.4 0 0 1 51.6,79 Z" />

</vector>
